APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# باید با آدرسی که در مرورگر باز می‌کنید یکی باشد (مثلاً http://customer-site.test) وگرنه فرم‌ها به localhost می‌روند و CSRF خطا می‌دهد.
APP_URL=http://localhost


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# برای Laragon/سرور واقعی معمولاً MySQL را فعال کنید و فقط php artisan migrate بزنید (نه migrate:fresh).
# DB_CONNECTION=sqlite با فایل database/database.sqlite برای توسعهٔ سریع بدون MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=customer_site
DB_USERNAME=root
DB_PASSWORD=

# نمونهٔ SQLite (اختیاری):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# برای کوکی روی همان هاستی که در مرورگر است؛ مقدار .test یا نام دامنه را اینجا نگذارید مگر زیردامنه‌های wildcard در پروداکشن.
# SESSION_DOMAIN=
# روی HTTP محلی (Laragon بدون HTTPS) حتماً false؛ روی HTTPS سرور true.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# MEDIA_DISK انتخاب مرکزی محل رسانه (avatar/product/theme). local | arvan | s3
# مقدار پیش‌فرض (خالی) یعنی همان رفتار فعلی — بدون تغییر.
MEDIA_DISK=
MEDIA_PRIVATE_DISK=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ArvanCloud Object Storage (used by the arvan_backup disk today, and by the
# arvan/arvan_private media disks once MEDIA_DISK=arvan is selected)
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_REGION=ir-thr-at1
ARVAN_BUCKET=
ARVAN_ENDPOINT=
ARVAN_URL=
ARVAN_MEDIA_BUCKET=
ARVAN_MEDIA_PREFIX=media
ARVAN_MEDIA_PRIVATE_PREFIX=media-private
ARVAN_MEDIA_URL=

VITE_APP_NAME="${APP_NAME}"

# Site template (optional; set in installer or admin)
SITE_NAME="سایت شرکتی"
SITE_THEME=default

# سایت مالک: وقتی true باشد این نصب به‌عنوان سایت فروش شما عمل می‌کند و لایسنس الزامی نیست.
OWNER_SITE=false

# آدرس پلتفرم (برای لایسنس و UX). در حالت سایت مالک بدون لایسنس می‌توان خالی گذاشت.
# PLATFORM_URL=https://panel.example.com

# Module activation (per installation)
MODULE_BLOG_ENABLED=true
MODULE_SHOP_ENABLED=false

# ??? Payment Gateway ?????????????????????????????????????
# �ѐ�� ����: zarinpal | idpay (���� = ���� �ѐ�� �������� ����)
PAYMENT_GATEWAY=
PAYMENT_SANDBOX=false
# PAYMENT_CALLBACK_URL=https://yoursite.com/subscription/callback

# ���䝁��
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ���흁�
# IDPAY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

