{
    "schema_version":  1,
    "production_branch":  "main",
    "remote":  "origin",
    "allowed_release_paths":  [
                                  ".deployment/**",
                                  "docs/**",
                                  "tests/**",
                                  "app/**",
                                  "packages/**",
                                  "resources/**",
                                  "routes/**",
                                  "database/**",
                                  "scripts/**",
                                  "config/builder-element-schemas.php",
                                  "config/builder-elements.php",
                                  ".gitignore",
                                  "composer.json",
                                  "composer.lock",
                                  "package.json",
                                  "package-lock.json",
                                  "phpunit.xml",
                                  "FINAL_ARTIFACT_GATE_TEST.txt",
                                  "FINAL_CUSTOMER_DEPLOY_TEST.txt",
                                  "_check_pkg.php",
                                  "_debug_forms.php",
                                  "_writer.php",
                                  "artifact-upload.txt",
                                  "artifact-v.txt",
                                  "artifact-v140-test-3.txt",
                                  "artifact-v141-test.txt",
                                  "artifact-v141-test111.txt",
                                  "artifact-v142-test.txt",
                                  "artifact-v143-test.txt",
                                  "count()",
                                  "deploy-test.txt",
                                  "deployment-test.txt",
                                  "echo",
                                  "origin)",
                                  "softDeletes()",
                                  "write.php"
                              ],
    "excluded_runtime_paths":  [
                                   ".env",
                                   ".env.*",
                                   "storage/**",
                                   "bootstrap/cache/**",
                                   "vendor/**",
                                   "node_modules/**",
                                   "public/build/**",
                                   "**/*.log",
                                   ".phpunit.result.cache"
                               ],
    "required_clean_state":  {
                                 "no_unresolved_merge":  true,
                                 "no_pre_staged_changes":  true,
                                 "tracked_excluded_paths_must_be_clean":  true,
                                 "unknown_untracked_files":  "block"
                             },
    "migration_policy":  {
                             "paths":  [
                                           "database/migrations/**"
                                       ],
                             "review_required_patterns":  [
                                                              "dropColumn\\s*\\(",
                                                              "dropIfExists\\s*\\(",
                                                              "Schema::drop\\s*\\(",
                                                              "-\u003echange\\s*\\(",
                                                              "DB::statement\\s*\\("
                                                          ],
                             "reviewed":  [
                                              {
                                                  "path":  "database/migrations/2026_10_27_120000_create_newsletter_subscribers_table.php",
                                                  "sha256":  "c2eb08f8a3a795d6b99d93902615747f434430b1086084d02f9e16ddc9dd5fb7",
                                                  "reviewed_by":  "safhenokhostweb-art",
                                                  "reviewed_at":  "2026-10-27",
                                                  "reason":  "Create-only migration: up() creates newsletter_subscribers (guarded by hasTable); down() drops only that table (rollback of its own creation). No existing data is altered."
                                              }
                                          ]
                         },
    "dependency_rules":  [
                             {
                                 "when":  "composer.json",
                                 "requires":  "composer.lock"
                             },
                             {
                                 "when":  "package.json",
                                 "requires":  "package-lock.json"
                             }
                         ],
    "git_dependencies":  [
                             {
                                 "name":  "saas-platform",
                                 "path":  "{project_root}/../saas-platform",
                                 "branch":  "main"
                             }
                         ],
    "build":  {
                  "required":  true,
                  "artifact":  "server-managed-exact-commit"
              },
    "health":  {
                   "required":  true,
                   "endpoint_source":  "deployment-system project http_health_check"
               },
    "metadata":  {
                     "local_directory":  ".git/deployment/releases"
                 },
    "project_key":  "customer-site",
    "checks":  [
                   {
                       "command":  "php tests/ReleaseGate/known-issues.php \u0026\u0026 php tests/ReleaseGate/known-issue-groups.php",
                       "name":  "known-issue-guard-tests",
                       "type":  "test"
                   },
                   {
                       "command":  "php scripts/verify-release-known-issues.php --run-tests",
                       "name":  "theme-canvas-regression",
                       "type":  "test"
                   },
                   {
                       "command":  "php tests/ReleaseGate/run.php",
                       "name":  "artifact-gate-tests",
                       "type":  "test"
                   }
               ]
}
