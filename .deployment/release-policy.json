{
    "schema_version":  1,
    "production_branch":  "main",
    "remote":  "origin",
    "allowed_release_paths":  [
                                  ".deployment/**",
                                  "docs/**",
                                  "tests/**",
                                  "app/**",
                                  "packages/**",
                                  "resources/**",
                                  "routes/**",
                                  "database/**",
                                  "scripts/**",
                                  ".gitignore",
                                  "composer.json",
                                  "composer.lock",
                                  "package.json",
                                  "package-lock.json",
                                  "phpunit.xml"
                              ],
    "excluded_runtime_paths":  [
                                   ".env",
                                   ".env.*",
                                   "storage/**",
                                   "bootstrap/cache/**",
                                   "vendor/**",
                                   "node_modules/**",
                                   "public/build/**",
                                   "**/*.log",
                                   ".phpunit.result.cache"
                               ],
    "required_clean_state":  {
                                 "no_unresolved_merge":  true,
                                 "no_pre_staged_changes":  true,
                                 "tracked_excluded_paths_must_be_clean":  true,
                                 "unknown_untracked_files":  "block"
                             },
    "migration_policy":  {
                             "paths":  [
                                           "database/migrations/**"
                                       ],
                             "review_required_patterns":  [
                                                              "dropColumn\\s*\\(",
                                                              "dropIfExists\\s*\\(",
                                                              "Schema::drop\\s*\\(",
                                                              "-\u003echange\\s*\\(",
                                                              "DB::statement\\s*\\("
                                                          ]
                         },
    "dependency_rules":  [
                             {
                                 "when":  "composer.json",
                                 "requires":  "composer.lock"
                             },
                             {
                                 "when":  "package.json",
                                 "requires":  "package-lock.json"
                             }
                         ],
    "build":  {
                  "required":  true,
                  "artifact":  "server-managed-exact-commit"
              },
    "health":  {
                   "required":  true,
                   "endpoint_source":  "deployment-system project http_health_check"
               },
    "metadata":  {
                     "local_directory":  ".git/deployment/releases"
                 },
    "project_key":  "customer-site",
    "checks":  [
                   {
                       "command":  "php tests/ReleaseGate/known-issues.php \u0026\u0026 php tests/ReleaseGate/known-issue-groups.php",
                       "name":  "known-issue-guard-tests",
                       "type":  "test"
                   },
                   {
                       "command":  "php scripts/verify-release-known-issues.php --run-tests",
                       "name":  "theme-canvas-regression",
                       "type":  "test"
                   },
                   {
                       "command":  "php tests/ReleaseGate/run.php",
                       "name":  "artifact-gate-tests",
                       "type":  "test"
                   }
               ]
}
