* text=auto eol=lf

# Explicit UTF-8 + LF for all source files — prevents double-encoding on Windows
*.php       text eol=lf
*.blade.php text eol=lf diff=html
*.js        text eol=lf
*.css       text eol=lf diff=css
*.html      text eol=lf diff=html
*.md        text eol=lf diff=markdown
*.json      text eol=lf
*.env*      text eol=lf

# Deploy scripts: force native line endings per platform
*.sh  text eol=lf
*.bat text eol=crlf

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Runtime/customer state must never enter source-derived release artifacts.
/storage/backups export-ignore
/storage/uploads export-ignore
/storage/advertisements export-ignore
/storage/installed.lock export-ignore
/public/uploads export-ignore
